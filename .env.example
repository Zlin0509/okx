# demo is always the default. offline runs locally without credentials.
OKX_MODE=demo
OKX_DATA_SOURCE=offline
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_BASE_URL=https://www.okx.com
# Live additionally requires OKX_MODE=live, data source okx and this exact phrase.
OKX_LIVE_ACK=
MAX_ORDER_USDT=100
MAX_POSITION_USDT=500
MAX_EQUITY_FRACTION=0.10
MAX_SLIPPAGE_BPS=20
DATABASE_PATH=data/workbench.sqlite3
