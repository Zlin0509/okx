# demo is always the default. offline runs locally without credentials.
OKX_MODE=demo
OKX_DATA_SOURCE=offline
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_BASE_URL=https://www.okx.com
# Live is disabled in this release: no cross-host account coordinator/fencing.
OKX_LIVE_ACK=
MAX_ORDER_USDT=100
MAX_POSITION_USDT=500
MAX_EQUITY_FRACTION=0.10
MAX_SLIPPAGE_BPS=20
DATABASE_PATH=data/workbench.sqlite3
MAX_SIGNAL_AGE_SECONDS=300
